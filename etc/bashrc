# Search
if type -P rg &>/dev/null ; then
  g(){
    rg "$*" --smart-case
  }
  gw(){
    rg "$*" --smart-case --word-regexp
  }
  gnolog(){
    rg "$*" --smart-case --glob '!log/'
  }
  f(){
    rg --files | rg -i "$*"
  }
else
  g(){
    grep -Rin $1 *
  }
  f(){
    find . -iname "$1"
  }
fi


