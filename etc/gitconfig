[core]
	excludesfile = ~/.gitignore
	pager = delta

[init]
	defaultBranch = main

[pull]
	rebase = merges

[push]
	autoSetupRemote = true

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	df = diff
	dc = diff --cached
	lg = log --oneline --graph --decorate
	last = log -1 HEAD
	amend = commit --amend --no-edit
	unstage = restore --staged --
	undo = reset --soft HEAD~1
	ui = !gitui
	dt = difftool -t difftastic --no-prompt

# delta (core.pager above) is a syntax-highlighting side-by-side pager for
# every diff-producing command (diff, show, log -p, blame). difftastic
# (structural/tree-sitter diffing) is available on demand instead via
# `git dt`, not as the default - better for understanding a refactor, but
# slower and less scannable for routine small diffs.
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"

# Machine/identity-specific settings (user.name, user.email, etc.) go in
# ~/.gitconfig.local, not here — same pattern as .bashrc_local/.vimrc.local.
# Missing include files are silently ignored by git, so this is safe even
# before that file exists.
#
# Since ~/.gitconfig is a symlink into this repo, DON'T use
# `git config --global ...` to set them — that writes through the symlink
# into this tracked file. Target the local file directly instead:
#   git config --file ~/.gitconfig.local user.name "Your Name"
#   git config --file ~/.gitconfig.local user.email "you@example.com"
[include]
	path = ~/.gitconfig.local
